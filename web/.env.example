# A URL deve ser do serviço BACKEND (API), não do front estático.
# Verificação: no navegador, /health deve retornar JSON: {"status":"ok"}
#
# Railway — backend (Node), outro serviço que não o do Vite:
# VITE_API_URL=https://seu-backend.up.railway.app
#
# Local:
VITE_API_URL=http://localhost:3333
